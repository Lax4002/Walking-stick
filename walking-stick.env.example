# Copy to /etc/wakatech/device.env and edit values. Do not commit real secrets.
# For a broker on your development laptop, MQTT_HOST must be that laptop's LAN
# address, never localhost. Confirm its listener/transport settings first.
MQTT_HOST=e2734df303a542cba4690f4a824a98a9.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=device-WK-2026-000042
MQTT_PASSWORD=12312345678
HARDWARE_ID=WK-2026-000042
DEVICE_SECRET=b7keQePuai1a-Qf5jNpqW9VNLhueQDK-4BM3l4M1y_HK3Rnnu3OES_Hv3h4K9Ys-
FIRMWARE_VERSION=1.0.0
PROTOCOL_VERSION=1
STATE_DB=/var/lib/wakatech/device.db
# MQTT_CA=/etc/ssl/certs/your-broker-ca.pem

# A bare Pi has no battery gauge. Replace this with a current test value, or
# attach a Linux-supported UPS/fuel gauge whose capacity appears in sysfs.
WAKATECH_BATTERY_PERCENT=100
WAKATECH_HEARTBEAT_INTERVAL=60
WAKATECH_ACTIVITY_INTERVAL=300
WAKATECH_WALK_IDLE_SECONDS=120

# These map backend sensitivity settings to the MPU acceleration trigger.
# Tune them with controlled physical testing before relying on fall detection.
WAKATECH_FALL_THRESHOLD_LOW=3.0
WAKATECH_FALL_THRESHOLD_MEDIUM=2.5
WAKATECH_FALL_THRESHOLD_HIGH=2.0

# The legacy HTTP output remains optional. Leave its URL empty when MQTT is the
# only backend path.
WALKING_STICK_DEVICE_ID=stick-01
WALKING_STICK_API_URL=
WALKING_STICK_API_TOKEN=
WALKING_STICK_PHONE_NUMBERS=

# Optional hardware/configuration overrides:
# WALKING_STICK_GPS_PORT=/dev/serial0
# WALKING_STICK_GPS_BAUD=9600
# WALKING_STICK_GSM_PORT=/dev/ttyAMA1
# Location sent immediately at startup until the GPS gets its first valid fix.
# Use the stick's normal/home position; the Raspberry Pi has no built-in location sensor.
# Development fallback: FUT Minna main campus, Gidan Kwano. A valid GPS fix
# always replaces this fallback while the application is running.
WALKING_STICK_FALLBACK_LATITUDE=9.53101
WALKING_STICK_FALLBACK_LONGITUDE=6.4469
# MPU uses automatic I2C bus detection. Override with a bus number if needed.
# WALKING_STICK_I2C_BUS=20
# Audio uses the active PipeWire sink automatically (audio jack or Bluetooth).
# Set this only to force a specific PipeWire sink ID or ALSA device.
# WALKING_STICK_AUDIO_DEVICE=57
